# Copy to `.env` (or `.env.local`) before `npm run build` / `npm run dev`.
# All variables are optional — leaving a value blank is fine.

# ---------------------------------------------------------------------------
# Google Analytics 4
# ---------------------------------------------------------------------------
# Measurement ID from https://analytics.google.com/ (Admin → Data streams).
# Format: G-XXXXXXXXXX. When unset, the Analytics component is a no-op
# and zero `gtag` requests are emitted.
VITE_GA4_ID=

# ---------------------------------------------------------------------------
# Search-engine site verification tokens (paste the exact `content="..."`
# value the search engine asks you to add to `<meta name="..." content="">`).
# When empty, no verification meta is emitted on the home page.
# ---------------------------------------------------------------------------
VITE_GOOGLE_SITE_VERIFICATION=
VITE_YANDEX_VERIFICATION=
VITE_BING_VERIFICATION=

# ---------------------------------------------------------------------------
# Brand social profiles. Surfaced both as `Organization.sameAs` in the
# home-page JSON-LD (E-E-A-T signal) and as the icon row in the Footer.
# ---------------------------------------------------------------------------
VITE_PIKART_INSTAGRAM=
VITE_PIKART_TWITTER=
VITE_PIKART_TELEGRAM=
VITE_PIKART_WHATSAPP=

# ---------------------------------------------------------------------------
# External review-platform profiles. When set, both URLs are appended to
# the Organization JSON-LD `sameAs` array (so Google can link the brand
# entity to its public reviews) AND a "Trustpilot / Google Business"
# trust-strip is rendered on the home page footer. Leave blank until the
# operator has registered the business on the matching platform.
#
# Roadmap reference: B5 in `pikart-roadmap-to-1.md`.
# ---------------------------------------------------------------------------
VITE_PIKART_TRUSTPILOT_URL=
VITE_PIKART_GOOGLE_BUSINESS_URL=

# ---------------------------------------------------------------------------
# Lead author (Dusya — دوسیا) public profiles. Surfaced as
# `Article.author.sameAs` on every post she signs (currently every post
# whose primary category is NOT one of the four "technical" verticals).
# ---------------------------------------------------------------------------
VITE_PIKART_AUTHOR_DUSYA_LINKEDIN=
VITE_PIKART_AUTHOR_DUSYA_TWITTER=
VITE_PIKART_AUTHOR_DUSYA_GITHUB=
VITE_PIKART_AUTHOR_DUSYA_TELEGRAM=
VITE_PIKART_AUTHOR_DUSYA_INSTAGRAM=

# ---------------------------------------------------------------------------
# Secondary editor (technical desk — devtools / cloud / productivity /
# AI-writing-SEO). Once you have a real team member's profile URLs,
# paste them here so `Article.author.sameAs` is non-empty for technical
# posts. The display name is overridable via SECONDARY_AUTHOR_NAME in
# `src/lib/seo.ts` (operator should change to a real team member).
# Roadmap reference: B4 in `pikart-roadmap-to-1.md`.
# ---------------------------------------------------------------------------
VITE_PIKART_AUTHOR_REZA_LINKEDIN=
VITE_PIKART_AUTHOR_REZA_TWITTER=
VITE_PIKART_AUTHOR_REZA_GITHUB=
VITE_PIKART_AUTHOR_REZA_TELEGRAM=
VITE_PIKART_AUTHOR_REZA_INSTAGRAM=

# ---------------------------------------------------------------------------
# E-Namad (نماد اعتماد الکترونیکی) embed. Paste the raw <iframe> HTML
# enamad.ir gives you after registration. Empty = footer renders the
# "ثبت در حال انجام" placeholder (we never claim a credential we don't
# have).
# ---------------------------------------------------------------------------
VITE_ENAMAD_IFRAME_HTML=

# ---------------------------------------------------------------------------
# Local-business signals (geo metas + LocalBusiness JSON-LD). Defaults
# point at Tehran province. ISO 3166-2 region code, lat;lng position.
# ---------------------------------------------------------------------------
VITE_PIKART_GEO_REGION=
VITE_PIKART_GEO_PLACENAME=
VITE_PIKART_GEO_POSITION=
VITE_PIKART_GEO_MAP_URL=
VITE_PIKART_CURRENCIES=
VITE_PIKART_PAYMENT=
